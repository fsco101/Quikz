PORT=5000
MONGODB_URI=
JWT_SECRET=
NODE_ENV=development
# Exact frontend origins, separated by commas. Required in production.
# Example: https://quikz.vercel.app,https://learn.example.com
CORS_ORIGINS=
# Required in production; point this at a persistent disk mount.
# Render Blueprint sets /var/data/quikz/uploads. Blank uses backend/uploads locally.
UPLOAD_DIR=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=administrator
ADMIN_FULL_NAME=System Administrator
SEED_DEMO_DATA=false
