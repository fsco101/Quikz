PORT=5000
# Persistent MongoDB/Atlas database; also stores private module and quiz drafts.
MONGODB_URI=
JWT_SECRET=
NODE_ENV=development
# Exact frontend origins, separated by commas. Required in production.
# Example: https://quikz.vercel.app,https://learn.example.com
CORS_ORIGINS=
# Required in production; point this at a persistent disk mount.
# Render Blueprint sets /var/data/quikz/uploads. Blank uses backend/uploads locally.
UPLOAD_DIR=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=administrator
ADMIN_FULL_NAME=System Administrator
SEED_DEMO_DATA=false
# Optional server-side avatar storage. Set all three to use Cloudinary.
# Leave all blank to keep storing sanitized avatars in MongoDB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
